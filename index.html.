
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1746A2">
<title>LOCKIIN Academic | Your Academic World, Connected.</title>
<meta name="description" content="LOCKIIN Academic helps ABSU students discover academic resources, past questions and study materials.">

<style>
:root {
  --blue: #1746A2;
  --dark-blue: #103579;
  --black: #111111;
  --yellow: #FFC928;
  --white: #FFFFFF;
  --light: #F5F7FC;
  --gray: #687386;
  --border: #E5E9F1;
  --radius: 14px;
  --shadow: 0 10px 35px rgba(17,17,17,.06);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  font-family: Inter, Arial, Helvetica, sans-serif;
  background: var(--white);
  color: var(--black);
  line-height: 1.6;
}

button, input, select { font: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }

.container {
  width: 88%;
  max-width: 1200px;
  margin: auto;
}

/* HEADER */

header {
  height: 78px;
  background: white;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 88%;
  max-width: 1200px;
  margin: auto;
}

.logo {
  font-size: 27px;
  font-weight: 950;
  letter-spacing: -1.5px;
  color: var(--blue);
}

.logo span { color: var(--black); }

.logo-mark {
  display: inline-flex;
  background: var(--yellow);
  color: var(--black);
  width: 29px;
  height: 29px;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  font-size: 17px;
  margin-right: 5px;
}

nav {
  display: flex;
  align-items: center;
  gap: 29px;
}

nav a {
  font-size: 13px;
  font-weight: 700;
  transition: .2s;
}

nav a:hover { color: var(--blue); }

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.login-btn {
  border: 1px solid var(--border);
  background: white;
  padding: 10px 17px;
  border-radius: 8px;
  font-weight: 700;
}

.signup-btn {
  border: none;
  background: var(--blue);
  color: white;
  padding: 11px 18px;
  border-radius: 8px;
  font-weight: 700;
}

.menu-btn {
  display: none;
  background: none;
  border: 0;
  font-size: 27px;
  color: var(--black);
}

/* HERO */

.hero {
  background: var(--light);
  padding: 85px 0;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 55px;
}

.eyebrow {
  display: inline-flex;
  background: #E6EEFF;
  color: var(--blue);
  padding: 8px 14px;
  border-radius: 30px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .8px;
  margin-bottom: 23px;
}

.hero h1 {
  font-size: clamp(43px, 5.5vw, 68px);
  line-height: 1.08;
  letter-spacing: -3px;
  max-width: 650px;
}

.hero h1 span { color: var(--blue); }

.hero-description {
  max-width: 490px;
  color: var(--gray);
  font-size: 16px;
  margin: 23px 0 30px;
}

.hero-actions {
  display: flex;
  gap: 13px;
  flex-wrap: wrap;
}

.primary-btn {
  background: var(--blue);
  color: white;
  padding: 14px 22px;
  border: 0;
  border-radius: 8px;
  font-weight: 800;
  display: inline-block;
  transition: .2s;
}

.primary-btn:hover {
  background: var(--dark-blue);
  transform: translateY(-2px);
}

.secondary-btn {
  background: white;
  border: 1px solid var(--border);
  padding: 13px 20px;
  border-radius: 8px;
  font-weight: 700;
}

.hero-visual {
  background: var(--blue);
  border-radius: 22px;
  padding: 30px;
  min-height: 340px;
  color: white;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(23,70,162,.2);
}

.hero-visual:after {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  background: var(--yellow);
  border-radius: 50%;
  opacity: .12;
  right: -75px;
  top: -70px;
}

.hero-visual .visual-label {
  font-size: 12px;
  letter-spacing: 1px;
  font-weight: 800;
  color: #DCE7FF;
}

.hero-visual .visual-letter {
  font-size: 110px;
  font-weight: 950;
  color: var(--yellow);
  line-height: 1.3;
  margin-top: 5px;
}

.hero-visual h2 {
  font-size: 28px;
  line-height: 1.2;
}

.hero-visual p {
  color: #E1E9FA;
  font-size: 14px;
  margin-top: 10px;
}

.visual-bottom {
  display: flex;
  gap: 9px;
  margin-top: 24px;
  flex-wrap: wrap;
}

.visual-bottom span {
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 11px;
}

/* STATS */

.stats {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  padding: 30px 0;
  border-bottom: 1px solid var(--border);
  text-align: center;
}

.stat strong {
  font-size: 22px;
  display: block;
  color: var(--blue);
}

.stat p {
  color: var(--gray);
  font-size: 12px;
}

/* GENERAL SECTIONS */

section { padding: 78px 0; }

.section-top { margin-bottom: 30px; }

.section-tag {
  color: var(--blue);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1px;
}

.section-top h2 {
  font-size: clamp(27px,3.5vw,36px);
  letter-spacing: -1px;
  margin: 8px 0;
}

.section-top p {
  color: var(--gray);
  font-size: 14px;
}

/* MARKETPLACE */

.marketplace { background: white; }

.search-panel {
  background: var(--light);
  border: 1px solid var(--border);
  padding: 23px;
  border-radius: var(--radius);
  margin-bottom: 28px;
}

.search-row {
  display: flex;
  gap: 10px;
}

.search-row input {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: white;
  padding: 14px;
  outline: none;
}

.search-row input:focus {
  border-color: var(--blue);
}

.search-row button {
  background: var(--blue);
  color: white;
  border: 0;
  border-radius: 8px;
  padding: 0 22px;
  font-weight: 800;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 17px;
}

.filter {
  padding: 9px 15px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 30px;
  font-size: 12px;
  font-weight: 700;
}

.filter.active {
  background: var(--blue);
  color: white;
  border-color: var(--blue);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 22px;
}

.product-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  background: white;
  transition: .25s;
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
}

.product-image {
  height: 160px;
  background: #EDF2FC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54px;
  position: relative;
}

.product-label {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--yellow);
  color: var(--black);
  padding: 5px 9px;
  border-radius: 5px;
  font-size: 9px;
  font-weight: 900;
}

.product-info { padding: 19px; }

.product-category {
  color: var(--blue);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .7px;
}

.product-info h3 {
  font-size: 17px;
  margin: 7px 0;
}

.product-description {
  color: var(--gray);
  font-size: 12px;
  min-height: 38px;
}

.product-bottom {
  border-top: 1px solid var(--border);
  margin-top: 17px;
  padding-top: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.product-price {
  font-size: 18px;
  font-weight: 900;
}

.view-btn {
  border: none;
  background: var(--blue);
  color: white;
  border-radius: 7px;
  padding: 9px 12px;
  font-size: 11px;
  font-weight: 800;
}

.no-results {
  display: none;
  grid-column: 1/-1;
  padding: 35px;
  text-align: center;
  color: var(--gray);
  border: 1px dashed var(--border);
  border-radius: 12px;
}

/* FEATURES */

.features { background: var(--light); }

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.feature-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 26px;
}

.feature-icon {
  background: #E8EEFA;
  color: var(--blue);
  width: 48px;
  height: 48px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  font-size: 23px;
  margin-bottom: 17px;
}

.feature-card h3 { font-size: 17px; margin-bottom: 9px; }

.feature-card p {
  font-size: 13px;
  color: var(--gray);
}

/* ABOUT / CTA */

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 50px;
}

.about-panel {
  background: var(--blue);
  color: white;
  padding: 35px;
  border-radius: 18px;
}

.about-panel h3 {
  font-size: 28px;
  line-height: 1.3;
}

.about-panel p {
  margin-top: 13px;
  color: #E3EAFA;
  font-size: 14px;
}

.about-text p {
  color: var(--gray);
  margin-top: 13px;
  font-size: 14px;
}

.cta {
  background: var(--black);
  color: white;
  text-align: center;
  padding: 55px 20px;
  border-radius: 18px;
  margin: 0 0 75px;
}

.cta h2 { font-size: 32px; }

.cta p {
  color: #C9CED8;
  margin: 12px auto 23px;
  font-size: 14px;
}

.cta a {
  background: var(--yellow);
  color: var(--black);
  padding: 13px 22px;
  display: inline-block;
  border-radius: 8px;
  font-weight: 900;
}

/* FOOTER */

footer {
  background: var(--blue);
  color: white;
  padding: 48px 0 22px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 35px;
}

.footer-logo {
  font-size: 25px;
  font-weight: 950;
}

.footer-grid p {
  color: #DCE5F7;
  font-size: 13px;
  margin-top: 12px;
}

.footer-grid h4 { margin-bottom: 13px; }

.footer-grid a {
  display: block;
  color: #DCE5F7;
  font-size: 13px;
  margin-bottom: 9px;
}

.footer-grid a:hover { color: var(--yellow); }

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,.2);
  margin-top: 35px;
  padding-top: 20px;
  color: #DCE5F7;
  font-size: 11px;
}

/* MODAL */

.modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.6);
  z-index: 200;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal.show { display: flex; }

.modal-box {
  background: white;
  width: 100%;
  max-width: 430px;
  border-radius: 15px;
  padding: 28px;
  position: relative;
}

.modal-box h2 { color: var(--blue); margin-bottom: 10px; }

.modal-box p {
  color: var(--gray);
  font-size: 14px;
  margin-bottom: 18px;
}

.close-modal {
  position: absolute;
  right: 18px;
  top: 13px;
  background: none;
  border: none;
  font-size: 25px;
}

/* RESPONSIVE */

@media(max-width:900px) {
  nav {
    display: none;
    position: absolute;
    top: 78px;
    left: 0;
    width: 100%;
    padding: 25px 6%;
    background: white;
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  nav.open { display: flex; }

  .menu-btn {
    display: block;
    border: none;
    background: none;
    font-size: 27px;
  }

  .header-actions { display: none; }

  .hero-grid { grid-template-columns: 1fr; }

  .hero-visual { min-height: 280px; }

  .product-grid,.feature-grid { grid-template-columns: repeat(2,1fr); }

  .about-grid { grid-template-columns: 1fr; }
}

@media(max-width:550px) {
  .container,.header-inner { width: 90%; }

  .hero { padding: 60px 0; }

  .hero h1 {
    font-size: 44px;
    letter-spacing: -2px;
  }

  section { padding: 60px 0; }

  .stats { grid-template-columns: repeat(3,1fr); }

  .stat strong { font-size: 17px; }

  .stat p { font-size: 10px; }

  .product-grid,.feature-grid { grid-template-columns: 1fr; }

  .search-row { flex-direction: column; }

  .search-row button { padding: 12px; }

  .footer-grid { grid-template-columns: 1fr 1fr; }

  .footer-grid > div:first-child { grid-column: 1/-1; }

  .cta h2 { font-size: 26px; }
}
</style>
</head>

